# ─── Server ──────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── Database ─────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/secondmuma

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=30d

# ─── OTP ──────────────────────────────────────────────────────────────────────
# OTP is valid for these many minutes
OTP_EXPIRY_MINUTES=10
# In development mode OTP is always 123456 (no SMS sent)
# Set to 'true' for production to enable real SMS gateway
SEND_REAL_OTP=false

# ─── Payment (UPI) ────────────────────────────────────────────────────────────
UPI_MERCHANT_ID=secondmuma@upi
UPI_MERCHANT_NAME=SecondMuma

# ─── Client URL (CORS) ────────────────────────────────────────────────────────
CLIENT_URL=http://localhost:3000
